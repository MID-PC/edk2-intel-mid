diff --git a/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c b/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c
index 912048eee9..3d88a87c5f 100644
--- a/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c
+++ b/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c
@@ -591,6 +591,76 @@ EhcInitHC (
   //
   EhcWriteOpReg (Ehc, EHC_USBINTR_OFFSET, 0);
 
+  //
+  // CloverTrail/Atom Z25xx OTG0 is a Chipidea/ARC dual-role core using the LPM
+  // register map (USBMODE at operational offset 0xC8). EhcResetHC()'s HCRESET
+  // clears USBMODE.CM back to idle/device mode, so the host schedules are never
+  // traversed and USBSTS.PSS/ASS never follow USBCMD - which makes
+  // EhcEnablePeriodSchd() time out with "failed to enable period schedule".
+  // Re-assert CM=3 (host) plus SDIS here, while the controller is still halted
+  // and before USBCMD.RUN is set. On a standard EHCI controller offset 0xC8 is
+  // reserved and CM will simply never read back as 3, so nothing is programmed.
+  //
+  RegVal = EhcReadOpReg (Ehc, 0xC8);
+  if ((RegVal & 0x3) != 0x3) {
+    EhcWriteOpReg (Ehc, 0xC8, (RegVal & (UINT32)~0x3) | 0x13);
+    gBS->Stall (1000);
+    RegVal = EhcReadOpReg (Ehc, 0xC8);
+    DEBUG ((DEBUG_ERROR, "EhcInitHC: CT re-asserted Chipidea host mode, USBMODE 0x%08x\n", RegVal));
+
+    //
+    // Writing USBMODE.CM switches the Chipidea core between device and host
+    // role, and that reinitializes its register file: PERIODICLISTBASE
+    // (op+0x14) and ASYNCLISTADDR (op+0x18), which EhcInitSched() programmed
+    // above, are cleared back to 0. USBCMD.RUN is set right after this block,
+    // so the core then fetches its schedule from address 0, raises
+    // USBSTS.HSE (host system error) and halts itself - which shows up as
+    // FRINDEX advancing while PERIODIC/ASYNC read 0, "HC halted at entrance"
+    // on the first control transfer and SET_ADDRESS failing with Device Error.
+    // Rebuild the schedule after the mode change so both list pointers are
+    // valid before the controller is started.
+    //
+    EhcFreeSched (Ehc);
+    Status = EhcInitSched (Ehc);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+
+    DEBUG ((
+      DEBUG_ERROR,
+      "EhcInitHC: CT schedule reprogrammed after mode switch, PERIODIC 0x%08x ASYNC 0x%08x\n",
+      EhcReadOpReg (Ehc, EHC_FRAME_BASE_OFFSET),
+      EhcReadOpReg (Ehc, EHC_ASYNC_HEAD_OFFSET)
+      ));
+  }
+
+  //
+  // CloverTrail/Atom Z25xx OTG0: this Chipidea core implements HOSTPC1 at
+  // operational offset 0x84 (== BAR+0xB4, the byte the stock OTG0 ASL calls
+  // "UFOT"). Out of HCRESET, HOSTPC1.ASUS (BIT0, automatic PHY low power
+  // suspend) is set and PHCD (BIT22, PHY clock disable) may be set too. With
+  // ASUS enabled the PHY is parked whenever the port is idle, so the periodic
+  // (interrupt) schedule never actually moves data: a keyboard/mouse is powered
+  // and answers control transfers (SET_ADDRESS, descriptors, the num-lock LED
+  // SET_REPORT) but its interrupt IN QTDs stay active forever, so no HID
+  // reports are ever delivered. ehci-hcd.c does the same for has_hostpc cores
+  // after every reset. Only touch it on the Chipidea core, i.e. when USBMODE
+  // (op+0xC8) really reads back CM=3; on standard EHCI that never happens.
+  //
+  if ((EhcReadOpReg (Ehc, 0xC8) & 0x3) == 0x3) {
+    RegVal = EhcReadOpReg (Ehc, 0x84);
+    if ((RegVal & (BIT0 | BIT22)) != 0) {
+      EhcWriteOpReg (Ehc, 0x84, RegVal & (UINT32) ~(BIT0 | BIT22));
+      gBS->Stall (1000);
+      DEBUG ((
+        DEBUG_ERROR,
+        "EhcInitHC: CT HOSTPC1 0x%08x -> 0x%08x (ASUS/PHCD cleared)\n",
+        RegVal,
+        EhcReadOpReg (Ehc, 0x84)
+        ));
+    }
+  }
+
   //
   // 2. Start the Host Controller
   //
