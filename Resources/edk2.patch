diff --git a/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c b/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c
index 912048eee9..ca3ba0cf69 100644
--- a/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c
+++ b/MdeModulePkg/Bus/Pci/EhciDxe/EhciReg.c
@@ -591,6 +591,65 @@ EhcInitHC (
   //
   EhcWriteOpReg (Ehc, EHC_USBINTR_OFFSET, 0);
 
+  //
+  // CloverTrail OTG0 is a Chipidea dual-role core with USBMODE at op+0xC8.
+  // HCRESET clears USBMODE.CM to device mode, so the host schedules are never
+  // traversed and EhcEnablePeriodSchd() times out with "failed to enable period
+  // schedule". Re-assert CM=3|SDIS while still halted, before USBCMD.RUN.
+  // Standard EHCI reserves 0xC8, so CM never reads back as 3 and nothing runs.
+  //
+  RegVal = EhcReadOpReg (Ehc, 0xC8);
+  if ((RegVal & 0x3) != 0x3) {
+    EhcWriteOpReg (Ehc, 0xC8, (RegVal & (UINT32)~0x3) | 0x13);
+    gBS->Stall (1000);
+    RegVal = EhcReadOpReg (Ehc, 0xC8);
+    DEBUG ((DEBUG_ERROR, "EhcInitHC: CT re-asserted Chipidea host mode, USBMODE 0x%08x\n", RegVal));
+
+    //
+    // Writing USBMODE.CM reinitializes the register file, clearing the
+    // PERIODICLISTBASE (op+0x14) and ASYNCLISTADDR (op+0x18) that
+    // EhcInitSched() just programmed. USBCMD.RUN is set next, so the core would
+    // fetch from address 0, raise USBSTS.HSE and halt itself - FRINDEX advancing
+    // while both list heads read 0, "HC halted at entrance" on the first control
+    // transfer. Rebuild the schedule after the mode change.
+    //
+    EhcFreeSched (Ehc);
+    Status = EhcInitSched (Ehc);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+
+    DEBUG ((
+      DEBUG_ERROR,
+      "EhcInitHC: CT schedule reprogrammed after mode switch, PERIODIC 0x%08x ASYNC 0x%08x\n",
+      EhcReadOpReg (Ehc, EHC_FRAME_BASE_OFFSET),
+      EhcReadOpReg (Ehc, EHC_ASYNC_HEAD_OFFSET)
+      ));
+  }
+
+  //
+  // CloverTrail OTG0 implements HOSTPC1 at op+0x84 (BAR+0xB4, "UFOT" in the
+  // stock OTG0 ASL). Out of HCRESET, ASUS (BIT0, automatic PHY low power
+  // suspend) is set and PHCD (BIT22) may be, and with ASUS the PHY parks
+  // whenever the port is idle, so the periodic schedule never moves data: a
+  // keyboard answers control transfers but its interrupt IN QTDs stay active,
+  // so no HID reports arrive. ehci-hcd.c clears both the same way for
+  // has_hostpc cores. Reached only when USBMODE reads CM=3, never on plain EHCI.
+  //
+  if ((EhcReadOpReg (Ehc, 0xC8) & 0x3) == 0x3) {
+    RegVal = EhcReadOpReg (Ehc, 0x84);
+    if ((RegVal & (BIT0 | BIT22)) != 0) {
+      EhcWriteOpReg (Ehc, 0x84, RegVal & (UINT32) ~(BIT0 | BIT22));
+      gBS->Stall (1000);
+      DEBUG ((
+        DEBUG_ERROR,
+        "EhcInitHC: CT HOSTPC1 0x%08x -> 0x%08x (ASUS/PHCD cleared)\n",
+        RegVal,
+        EhcReadOpReg (Ehc, 0x84)
+        ));
+    }
+  }
+
   //
   // 2. Start the Host Controller
   //
diff --git a/MdeModulePkg/Core/Dxe/Gcd/Gcd.c b/MdeModulePkg/Core/Dxe/Gcd/Gcd.c
index de27f63791..6144bafe7c 100644
--- a/MdeModulePkg/Core/Dxe/Gcd/Gcd.c
+++ b/MdeModulePkg/Core/Dxe/Gcd/Gcd.c
@@ -2763,6 +2763,52 @@ CoreInitializeGcdServices (
   for (Hob.Raw = *HobStart; !END_OF_HOB_LIST (Hob); Hob.Raw = GET_NEXT_HOB (Hob)) {
     if (GET_HOB_TYPE (Hob) == EFI_HOB_TYPE_MEMORY_ALLOCATION) {
       MemoryHob   = Hob.MemoryAllocation;
+      //
+      // CT: PEI can emit allocation HOBs identical to, or contained in, an
+      // earlier one. Re-promoting the same pages reaches CoreConvertPages() with
+      // them already non-conventional, which bails with 'ConvertPages:
+      // Incompatible memory types' and leaves the descriptor inconsistent, so a
+      // later large allocation lands on it and the board resets. Skip any HOB an
+      // earlier allocation HOB already fully covers.
+      //
+      {
+        EFI_PEI_HOB_POINTERS  CtPrevHob;
+        BOOLEAN               CtCovered;
+        EFI_PHYSICAL_ADDRESS  CtStart;
+        EFI_PHYSICAL_ADDRESS  CtEnd;
+        EFI_PHYSICAL_ADDRESS  CtPrevStart;
+        EFI_PHYSICAL_ADDRESS  CtPrevEnd;
+
+        CtCovered = FALSE;
+        CtStart   = MemoryHob->AllocDescriptor.MemoryBaseAddress;
+        CtEnd     = CtStart + MemoryHob->AllocDescriptor.MemoryLength;
+
+        for (CtPrevHob.Raw = *HobStart; CtPrevHob.Raw != Hob.Raw; CtPrevHob.Raw = GET_NEXT_HOB (CtPrevHob)) {
+          if (GET_HOB_TYPE (CtPrevHob) != EFI_HOB_TYPE_MEMORY_ALLOCATION) {
+            continue;
+          }
+
+          CtPrevStart = CtPrevHob.MemoryAllocation->AllocDescriptor.MemoryBaseAddress;
+          CtPrevEnd   = CtPrevStart + CtPrevHob.MemoryAllocation->AllocDescriptor.MemoryLength;
+
+          if ((CtPrevStart <= CtStart) && (CtPrevEnd >= CtEnd) && (CtPrevEnd != CtPrevStart)) {
+            CtCovered = TRUE;
+            break;
+          }
+        }
+
+        if (CtCovered) {
+          DEBUG ((
+            DEBUG_ERROR,
+            "CT: skipping already-covered memory allocation HOB type %d 0x%08lx - 0x%08lx\n",
+            (UINTN)MemoryHob->AllocDescriptor.MemoryType,
+            CtStart,
+            CtEnd - 1
+            ));
+          continue;
+        }
+      }
+
       BaseAddress = MemoryHob->AllocDescriptor.MemoryBaseAddress;
       Status      = CoreGetMemorySpaceDescriptor (BaseAddress, &Descriptor);
       if (!EFI_ERROR (Status)) {
