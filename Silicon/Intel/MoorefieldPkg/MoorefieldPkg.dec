[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = MoorefieldPkg
  PACKAGE_GUID                   = 2C7E9A15-4B6D-4F8A-9C31-7E5D2A1B4C60
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  gMoorefieldTokenSpaceGuid = { 0x7a1e4c2d, 0x9b3f, 0x4d5e, { 0x8a, 0x6c, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 } }

[PcdsFixedAtBuild]
  ## SCU IPC-1 register block (intel_scu_ipc, 0000:00:13.0 -> ff009000)
  gMoorefieldTokenSpaceGuid.PcdScuIpcBase|0xFF009000|UINT32|0x00000001

  ## South-complex PMU ("intel_pmu_driver", 0000:00:14.0 -> ff00b000)
  gMoorefieldTokenSpaceGuid.PcdPmuBase|0xFF00B000|UINT32|0x00000002

  ## External SD card SDHCI controller (mmc@ff3fa000, "intel,sdhci-tangier")
  gMoorefieldTokenSpaceGuid.PcdSdHostBase|0xFF3FA000|UINT32|0x00000003
  gMoorefieldTokenSpaceGuid.PcdSdHostSize|0x00001000|UINT32|0x00000004

  ## PMU LSS index that gates the SD/SDIO0 power island (Tangier SDIO0_01 = 1).
  ## The PMU must move this LSS to D0 before the SDHCI block responds.
  gMoorefieldTokenSpaceGuid.PcdSdHostPmuLss|1|UINT32|0x00000005
