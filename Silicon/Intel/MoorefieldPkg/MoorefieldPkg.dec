[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = MoorefieldPkg
  PACKAGE_GUID                   = 2C7E9A15-4B6D-4F8A-9C31-7E5D2A1B4C60
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  gMoorefieldTokenSpaceGuid = { 0x7a1e4c2d, 0x9b3f, 0x4d5e, { 0x8a, 0x6c, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 } }

  ##
  ## FFS file holding the board ACPI tables built as AML (the DSDT). AcpiPlatformDxe
  ## locates the file with this GUID through GetSectionFromAnyFv(), so a platform
  ## only has to set it as the FILE_GUID of its own ACPI tables INF.
  ##
  gMoorefieldAcpiTableStorageGuid = { 0x1b3d2a44, 0x9c07, 0x4e2f, { 0xa7, 0x1d, 0x63, 0x8e, 0x50, 0x9b, 0x22, 0x6c } }

[PcdsFixedAtBuild]
  ## Local APIC (xAPIC) MMIO window, published in the MADT.
  gMoorefieldTokenSpaceGuid.PcdLocalApicBase|0xFEE00000|UINT32|0x00000006
  gMoorefieldTokenSpaceGuid.PcdLocalApicSize|0x00001000|UINT32|0x00000007

  ## I/O APIC MMIO window, published in the MADT.
  gMoorefieldTokenSpaceGuid.PcdIoApicBase|0xFEC00000|UINT32|0x00000008
  gMoorefieldTokenSpaceGuid.PcdIoApicSize|0x00000400|UINT32|0x00000009

  ## IA-PC HPET register block, published in the HPET table and described by
  ## the PNP0103 device in the board DSDT. Must stay in sync with the HPET
  ## _CRS in Platforms/z00xsPkg/AcpiPlatformDxe/Dsdt.asl.
  gMoorefieldTokenSpaceGuid.PcdHpetBase|0xFED00000|UINT32|0x0000000A
  gMoorefieldTokenSpaceGuid.PcdHpetSize|0x00000400|UINT32|0x0000000B


  ## External SD card SDHCI controller (mmc@ff3fa000, "intel,sdhci-tangier")
  gMoorefieldTokenSpaceGuid.PcdSdHostBase|0xFF3FA000|UINT32|0x00000003
  gMoorefieldTokenSpaceGuid.PcdSdHostSize|0x00001000|UINT32|0x00000004

  ## PMU LSS index that gates the SD/SDIO0 power island (Tangier SDIO0_01 = 1).
  ## The PMU must move this LSS to D0 before the SDHCI block responds.
  gMoorefieldTokenSpaceGuid.PcdSdHostPmuLss|1|UINT32|0x00000005

  ## DWC3 USB3 host controller MMIO aperture (0000:00:11.0 -> f9100000).
  ## The xHCI registers sit at the base; the DWC3 global registers are at
  ## base + 0xC100. The 1MB extent is the real BAR size, taken from the
  ## mmio_pci_map table in intel_soc_dump.c. Must stay in sync with the PMM0
  ## PCI0 window in Platforms/z00xsPkg/AcpiPlatformDxe/Dsdt.asl.
  gMoorefieldTokenSpaceGuid.PcdDwc3Base|0xF9100000|UINT32|0x0000000C
  gMoorefieldTokenSpaceGuid.PcdDwc3Size|0x00100000|UINT32|0x0000000D

  ## langwell GPIO controller BAR0 (0000:00:0c.0 -> ff008000). This is where
  ## gpio-langwell.c reads its register base from on an Annedal part; firmware
  ## has no PCI bus to probe, so the BAR address is fixed here instead.
  ## lnw_gpio_ddata[TANGIER_GPIO] has gplr_offset = 4, so GPLR[0] is at
  ## PcdGpioBase + 4 rather than at the base.
  gMoorefieldTokenSpaceGuid.PcdGpioBase|0xFF008000|UINT32|0x0000000E

  ## SD card detect line as a langwell GPIO pin number. The SFI GPIO table this
  ## boot publishes names it "sd_cd_pin" on the "tangier_gpio" controller and
  ## resolves to pin 77; SdHostDxe reads the number out of that table and falls
  ## back to this PCD only when the table is absent. Kept here so the expected
  ## value is recorded and can be cross-checked against the SFI lookup.
  gMoorefieldTokenSpaceGuid.PcdSdCardCdPin|77|UINT32|0x0000000F

  ## PCI Express (MMCONFIG) window, bus 0 only (ZX551ML/tables/MCFG). Firmware
  ## reads device config space through it, and AcpiPlatformDxe publishes it in
  ## the MCFG table. Must stay in sync with PDRC in Dsdt.asl.
  gMoorefieldTokenSpaceGuid.PcdPciMmcfgBase|0x7F600000|UINT32|0x00000010
