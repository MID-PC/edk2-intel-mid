#include <IndustryStandard/Acpi.h>

//
// FACS Table
//
EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE FacsTable = {
  .Signature              = EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE_SIGNATURE,
  .Length                 = sizeof (EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE),
  .HardwareSignature      = 0,
  .FirmwareWakingVector   = 0,
  .GlobalLock             = 0,
  .Flags                  = 0,
  .XFirmwareWakingVector  = 0,
  .Version                = 0x02,
  .Reserved               = {0}
};

//
// FACS Table Reference
//
VOID *
ReferenceAcpiTable (
  VOID
  )
{
  return (VOID *)&FacsTable;
}
