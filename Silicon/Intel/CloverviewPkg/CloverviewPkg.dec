[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = CloverviewPkg
  PACKAGE_GUID                   = 1A2B3C4D-5E6F-7890-ABCD-EF1234567890
  PACKAGE_VERSION                = 0.1

[Includes]
  Include
  Acpi/Include

[Guids]
  gCloverviewTokenSpaceGuid = { 0x4f1c2d3e, 0x5a6b, 0x4c7d, { 0x8e, 0x9f, 0xa0, 0xb1, 0xc2, 0xd3, 0xe4, 0xf5 } }
  gCloverviewAcpiTableStorageGuid = { 0xF77A9DA4, 0x8DF3, 0x4B2C, { 0xA1, 0xE6, 0x0C, 0x57, 0xB2, 0xD3, 0x4E, 0x91 } }
  gEfiAcpiTableStorageGuid = { 0x7e374e25, 0x8e01, 0x4fee, { 0x87, 0xf2, 0x39, 0x0c, 0x23, 0xc6, 0x06, 0xcd } }

[PcdsFixedAtBuild]
  ## SD host controller (mmc1, SD card slot) MMIO window
  gCloverviewTokenSpaceGuid.PcdSdHostBase|0xFFA58000|UINT32|0x00000020
  gCloverviewTokenSpaceGuid.PcdSdHostSize|0x00001000|UINT32|0x00000021

  ## USB OTG controller (OTG0, 00:02.3 "penwell_otg")
  gCloverviewTokenSpaceGuid.PcdOtgHostBase|0xFFA60000|UINT32|0x00000024
  gCloverviewTokenSpaceGuid.PcdOtgHostSize|0x00001000|UINT32|0x00000025

  ## SCU IPC-1 register block (intel_scu_ipc)
  gCloverviewTokenSpaceGuid.PcdScuIpcBase|0xFF11C000|UINT32|0x00000022

  ## Langwell GPIO Core bank (clv_gpio_1), global GPIO base 96
  gCloverviewTokenSpaceGuid.PcdGpioCoreBase|0xFF13F000|UINT32|0x00000023

  ## Langwell GPIO AON bank (clv_gpio_0), global GPIO base 0
  gCloverviewTokenSpaceGuid.PcdGpioAuxBase|0xFF119000|UINT32|0x00000026
  ## South-complex PMU ("intel_pmu_driver", ff11d000-ff11dfff).
  gCloverviewTokenSpaceGuid.PcdPmuBase|0xFF11D000|UINT32|0x00000027
