## @file
#  Minimal Runtime Services stub for Clover Trail+ (Atom Z25xx).
#
#  Provides the Real Time Clock architectural protocol so the DXE Core can
#  finish dispatching. There is no usable RTC once the primary bootloader is
#  done with the SCU, so time is kept as a monotonic software clock.
#
#  It also keeps the SCU kernel watchdog stopped: the single stop issued in SEC
#  is undone whenever the SCU services later IPC traffic, so the stop is
#  re-issued periodically, at ReadyToBoot and at ExitBootServices.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PlatformRuntimeDxe
  FILE_GUID                      = 7F809192-A3B4-4C5D-8E6F-708192A3B4C5
  MODULE_TYPE                    = DXE_RUNTIME_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = PlatformRuntimeEntryPoint

[Sources]
  PlatformRuntimeDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Intel/CloverviewPkg/CloverviewPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  PcdLib

[Protocols]
  gEfiRealTimeClockArchProtocolGuid             ## PRODUCES

[Guids]
  gEfiEventExitBootServicesGuid                 ## CONSUMES ## Event
  gEfiEventReadyToBootGuid                      ## CONSUMES ## Event

[FixedPcd]
  gCloverviewTokenSpaceGuid.PcdScuIpcBase

[Depex]
  TRUE
