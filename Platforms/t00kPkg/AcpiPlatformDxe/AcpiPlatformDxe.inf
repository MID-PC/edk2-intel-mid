## @file
#  ACPI table installer for Intel Atom Z25xx (Clover Trail+, A502CG).
#
#  Reads the fixed ACPI tables (FADT/FACS/MADT/DBG2) from the Cloverview
#  FREEFORM file (gCloverviewAcpiTableStorageGuid) and the DSDT from the
#  device FREEFORM file (gEfiAcpiTableStorageGuid), and installs them through
#  EFI_ACPI_TABLE_PROTOCOL in the order FACS -> DSDT -> FADT -> MADT -> DBG2
#  (DBG2 only in the KDNET-USB build). This is what Windows' bootia32.efi
#  needs in order not to fail with 0xc0000225 ("the firmware (BIOS) is not
#  ACPI compatible").
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AcpiPlatformDxe
  FILE_GUID                      = 5B9974BA-C1B7-4170-8A9B-410D850D1094
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = AcpiPlatformEntryPoint

[Sources]
  AcpiPlatformDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Intel/CloverviewPkg/CloverviewPkg.dec
  Platforms/t00kPkg/t00kPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  DxeServicesLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gEfiAcpiTableStorageGuid                      ## CONSUMES  ## Device DSDT FREEFORM file
  gCloverviewAcpiTableStorageGuid               ## CONSUMES  ## SoC fixed-table FREEFORM file

[Protocols]
  gEfiAcpiTableProtocolGuid                     ## CONSUMES

[Depex]
  gEfiAcpiTableProtocolGuid
