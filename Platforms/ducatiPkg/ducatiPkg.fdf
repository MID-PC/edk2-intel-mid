
[FD.DUCATI]
BaseAddress   = 0x01101000 | gIntelMidTokenSpaceGuid.PcdFdBaseAddress
Size          = 0x00200000 | gIntelMidTokenSpaceGuid.PcdFdSize
ErasePolarity = 1
BlockSize     = 0x1000
NumBlocks     = 0x200

# SEC first so the image is directly executable
0x00000000|0x00010000
FV = FVSEC

0x00010000|0x001F0000
FV = FVMAIN

# SEC firmware volume
[FV.FVSEC]
BlockSize          = 0x1000
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

INF IntelPkg/Sec/SecMain.inf

# Main firmware volume: PEI + DXE
[FV.FVMAIN]
BlockSize          = 0x1000
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

# PEIM
INF  MdeModulePkg/Core/Pei/PeiMain.inf
INF  MdeModulePkg/Universal/PCD/Pei/Pcd.inf
INF  CloverviewPkg/PlatformPei/PlatformPei.inf
INF  MdeModulePkg/Core/DxeIplPeim/DxeIpl.inf

FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
   SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
     SECTION FV_IMAGE = FVDXE
   }
 }

# DXE firmware volume (LZMA compressed inside FVMAIN)
[FV.FVDXE]
BlockSize          = 0x1000
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

# PCD must dispatch first
APRIORI DXE {
  INF  MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
}

# DXE drivers
!include Include/DXE.inc

# ACPI
INF  RuleOverride = ACPITABLE ducatiPkg/AcpiPlatformDxe/AcpiTables.inf
FILE  FREEFORM = F77A9DA4-8DF3-4B2C-A1E6-0C57B2D34E91 {
  SECTION RAW = CloverviewPkg/Acpi/AcpiTables/Facs.aml
  SECTION RAW = CloverviewPkg/Acpi/AcpiTables/Facp.aml
  SECTION RAW = CloverviewPkg/Acpi/AcpiTables/Apic.aml
!ifdef KDNET_USB
  SECTION RAW = CloverviewPkg/Acpi/AcpiTables/Dbg2.aml
!endif
  SECTION RAW = CloverviewPkg/Acpi/AcpiTables/Csrt.aml
  # z2560 CPU topology/power states SSDT
  SECTION RAW = CloverviewPkg/Acpi/AcpiTables/SsdPpm2560.aml
}
!include CloverviewPkg/Extra.fdf.inc

# Common FDF rules
!include IntelPkg/Common.fdf.inc
